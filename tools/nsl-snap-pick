#!/usr/bin/env python3
"""PoC client for the NSL Snap GNOME Shell extension.

Asks the extension to let the user pick a window, then saves the capture as
PNG. See docs/06-poc-gnome-window-capture.md.
"""

import argparse
import datetime
import json
import pathlib
import re
import shutil
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, Gio, GLib  # noqa: E402

BUS_NAME = "ch.netslash.Snap.Shell"
OBJECT_PATH = "/ch/netslash/Snap"
INTERFACE = "ch.netslash.Snap1"


# Edge trimming (docs/02-decisions.md, D-010). Toolkits draw a soft outline
# around the window that does not line up with the frame rectangle (it was
# 1 logical px off on one side with Files). We crop to the opaque core so all
# four edges are hard; the app draws its own shadow later (D-004).
# How far from the frame edge we look for the opaque core, in logical px.
EDGE_SEARCH = 4

# Corner cleanup (D-009). The client-side shadow lies under the window and
# shows through the transparent corner cut-outs. Pixels below this alpha that
# are connected to a corner are shadow, not window.
CORNER_ALPHA_THRESHOLD = 80
# Largest corner radius we expect, in logical px (libadwaita uses 12-15).
CORNER_MAX_RADIUS = 24


def load_png(png: bytes) -> GdkPixbuf.Pixbuf:
    loader = GdkPixbuf.PixbufLoader.new_with_type("png")
    loader.write(png)
    loader.close()
    return loader.get_pixbuf()


def save_png(pixbuf: GdkPixbuf.Pixbuf) -> bytes:
    _, out = pixbuf.save_to_bufferv("png", [], [])
    return bytes(out)


def frame_in_image(info: dict) -> tuple[int, int, int, int]:
    """The frame rectangle in image px of a "buffer" capture."""
    fx, fy, fw, fh = info["frame-rect"]
    bx, by, _, _ = info["buffer-rect"]
    scale = info["scale"]
    return (round((fx - bx) * scale), round((fy - by) * scale), round(fw * scale), round(fh * scale))


def opaque_core(pixbuf: GdkPixbuf.Pixbuf, frame: tuple[int, int, int, int], scale: float):
    """Finds the opaque core of the window near the frame rectangle.

    For each side, looks within EDGE_SEARCH logical px of the frame edge for
    the outermost line whose middle half is fully opaque. Returns the core as
    (x, y, width, height), or None if a side has no opaque line, e.g. for a
    translucent window.
    """
    if not pixbuf.get_has_alpha():
        return None
    w, h = pixbuf.get_width(), pixbuf.get_height()
    n, rs = pixbuf.get_n_channels(), pixbuf.get_rowstride()
    data = pixbuf.get_pixels()
    fx, fy, fw, fh = frame
    margin = max(1, round(EDGE_SEARCH * scale))

    def column_opaque(x: int) -> bool:
        return all(data[y * rs + x * n + 3] == 255 for y in range(fy + fh // 4, fy + 3 * fh // 4))

    def row_opaque(y: int) -> bool:
        return all(data[y * rs + x * n + 3] == 255 for x in range(fx + fw // 4, fx + 3 * fw // 4))

    def search(candidates, opaque):
        return next((c for c in candidates if opaque(c)), None)

    left = search(range(max(0, fx - margin), min(w, fx + margin + 1)), column_opaque)
    right = search(range(min(w - 1, fx + fw - 1 + margin), max(-1, fx + fw - 1 - margin - 1), -1), column_opaque)
    top = search(range(max(0, fy - margin), min(h, fy + margin + 1)), row_opaque)
    bottom = search(range(min(h - 1, fy + fh - 1 + margin), max(-1, fy + fh - 1 - margin - 1), -1), row_opaque)
    if None in (left, right, top, bottom):
        return None
    return (left, top, right - left + 1, bottom - top + 1)


def clean_corners(pixbuf: GdkPixbuf.Pixbuf, scale: float) -> tuple[GdkPixbuf.Pixbuf, int]:
    """Makes shadow residue in the four corners fully transparent.

    Flood-fills from each corner pixel through pixels with alpha below
    CORNER_ALPHA_THRESHOLD, limited to a square of CORNER_MAX_RADIUS. The
    anti-aliased window edge has a higher alpha and is kept. Square corners
    (opaque corner pixel) are left alone.

    Returns the new pixbuf and the number of cleared pixels.
    """
    if not pixbuf.get_has_alpha():
        return pixbuf, 0

    w, h = pixbuf.get_width(), pixbuf.get_height()
    n, rs = pixbuf.get_n_channels(), pixbuf.get_rowstride()
    data = bytearray(pixbuf.get_pixels())
    size = min(round(CORNER_MAX_RADIUS * scale), w // 2, h // 2)

    def alpha_index(x: int, y: int) -> int:
        return y * rs + x * n + 3

    cleared = 0
    for x0, y0, dx, dy in ((0, 0, 1, 1), (w - 1, 0, -1, 1), (0, h - 1, 1, -1), (w - 1, h - 1, -1, -1)):
        stack = [(0, 0)]
        seen = set()
        while stack:
            i, j = stack.pop()
            if (i, j) in seen or not (0 <= i < size and 0 <= j < size):
                continue
            seen.add((i, j))
            a = alpha_index(x0 + dx * i, y0 + dy * j)
            if data[a] >= CORNER_ALPHA_THRESHOLD:
                continue
            if data[a]:
                data[a] = 0
                cleared += 1
            stack += [(i + 1, j), (i, j + 1), (i - 1, j), (i, j - 1)]

    if not cleared:
        return pixbuf, 0
    cleaned = GdkPixbuf.Pixbuf.new_from_bytes(
        GLib.Bytes.new(bytes(data)), GdkPixbuf.Colorspace.RGB, True, 8, w, h, rs
    )
    return cleaned, cleared


def process(png: bytes, info: dict, edges: str, clean: bool) -> bytes:
    """Turns a "buffer" capture into the final image; adds details to info."""
    pixbuf = load_png(png)
    scale = info.get("scale", 1.0)
    frame = frame_in_image(info)
    rect = frame
    if edges == "core":
        core = opaque_core(pixbuf, frame, scale)
        info["edges"] = "core" if core else "frame (no opaque core found)"
        rect = core or frame
    else:
        info["edges"] = "frame"
    x, y, w, h = rect
    pixbuf = pixbuf.new_subpixbuf(x, y, w, h).copy()
    info["trim"] = [rect[0] - frame[0], rect[1] - frame[1], (frame[0] + frame[2]) - (x + w), (frame[1] + frame[3]) - (y + h)]
    if clean:
        pixbuf, info["corner-pixels-cleared"] = clean_corners(pixbuf, scale)
    info["width"], info["height"] = pixbuf.get_width(), pixbuf.get_height()
    return save_png(pixbuf)


def default_output(title: str) -> pathlib.Path:
    pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
    base = pathlib.Path(pictures or pathlib.Path.home()) / "NSL Snap"
    stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    slug = re.sub(r"[^\w.-]+", "_", title).strip("_")[:60] or "window"
    return base / f"{stamp}_{slug}.png"


def main() -> int:
    parser = argparse.ArgumentParser(description="Pick a window and capture it.")
    parser.add_argument("-o", "--output", type=pathlib.Path, help="PNG file to write")
    parser.add_argument(
        "--crop",
        choices=["core", "frame", "buffer"],
        default="core",
        help="core: opaque window with hard edges (default); frame: frame rectangle, "
        "keeps the soft outline where it lies inside; buffer: raw, with shadow margins",
    )
    parser.add_argument(
        "--no-clean-corners",
        dest="clean_corners",
        action="store_false",
        help="keep shadow residue in the rounded corners",
    )
    parser.add_argument("--clipboard", action="store_true", help="also copy to clipboard (needs wl-copy)")
    parser.add_argument("--info", action="store_true", help="print capture metadata as JSON")
    args = parser.parse_args()

    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    # The app always takes the whole buffer and does the cropping itself.
    options = {"crop": GLib.Variant("s", "buffer")}
    try:
        result = bus.call_sync(
            BUS_NAME,
            OBJECT_PATH,
            INTERFACE,
            "PickWindow",
            GLib.Variant("(a{sv})", (options,)),
            GLib.VariantType("(aya{sv})"),
            Gio.DBusCallFlags.NONE,
            GLib.MAXINT,  # the user may take a while to pick
            None,
        )
    except GLib.Error as e:
        remote = Gio.DBusError.get_remote_error(e) or ""
        if remote.endswith(".Cancelled"):
            print("Cancelled.", file=sys.stderr)
            return 1
        if remote == "org.freedesktop.DBus.Error.ServiceUnknown":
            print("NSL Snap extension is not running (see docs/06-poc-gnome-window-capture.md).", file=sys.stderr)
            return 2
        print(f"Error: {Gio.DBusError.strip_remote_error(e) or e.message}", file=sys.stderr)
        return 2

    png = result.get_child_value(0).get_data_as_bytes().get_data()
    info = result.get_child_value(1).unpack()

    if args.crop != "buffer":
        png = process(png, info, args.crop, args.clean_corners)
    info["crop"] = args.crop

    output = args.output or default_output(info.get("title", ""))
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(png)
    print(output)

    if args.info:
        print(json.dumps(info, indent=2, ensure_ascii=False))

    if args.clipboard:
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy", "--type", "image/png"], input=png, check=False)
        else:
            print("wl-copy not found, skipped clipboard.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
